# ═══════════════════════════════════════════════════════════════════
# AEO Content Analyzer - Git Ignore
# ═══════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────
# Node.js / Frontend
# ───────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build outputs
dist/
dist-ssr/
build/
out/
.next/
.nuxt/
.cache/
*.local

# Test coverage
coverage/
.nyc_output/
frontend/coverage/

# ───────────────────────────────────────────────────────────────────
# Java / Maven / Spring Boot
# ───────────────────────────────────────────────────────────────────
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Gradle
.gradle/
build/
!gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# ───────────────────────────────────────────────────────────────────
# Environment Variables & Secrets (CRITICAL!)
# ───────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.env
!*.env.example

# ───────────────────────────────────────────────────────────────────
# Terraform (Infrastructure as Code)
# ───────────────────────────────────────────────────────────────────
**/.terraform/*
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfstate.backup
crash.log
crash.*.log

# Terraform variable files (contain secrets)
*.tfvars
*.tfvars.json
!terraform.tfvars.example

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration
.terraformrc
terraform.rc

# ───────────────────────────────────────────────────────────────────
# AWS Credentials & Keys
# ───────────────────────────────────────────────────────────────────
*.pem
*.key
*.ppk
.aws/
credentials

# ───────────────────────────────────────────────────────────────────
# Docker
# ───────────────────────────────────────────────────────────────────
# Ignore data volumes but keep config
**/data/
!**/data/.gitkeep

# Specific monitoring data
grafana/data/*
!grafana/data/.gitkeep
grafana/plugins/*
!grafana/plugins/.gitkeep

prometheus/data/*
!prometheus/data/.gitkeep

# Docker Compose overrides (local development)
docker-compose.override.yml

# ───────────────────────────────────────────────────────────────────
# Logs
# ───────────────────────────────────────────────────────────────────
*.log
logs/
*.log.*
npm-debug.log*
yarn-debug.log*

# Application logs
application.log
spring.log
error.log

# ───────────────────────────────────────────────────────────────────
# IDE / Editor
# ───────────────────────────────────────────────────────────────────
# VSCode
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Eclipse
.classpath
.project
.settings/
bin/

# NetBeans
nbproject/private/
nbbuild/
dist/
nbdist/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# ───────────────────────────────────────────────────────────────────
# OS Files
# ───────────────────────────────────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory

# ───────────────────────────────────────────────────────────────────
# Testing & Quality Tools
# ───────────────────────────────────────────────────────────────────
.scannerwork/
.sonar/
test-results/
junit.xml

# ───────────────────────────────────────────────────────────────────
# Temporary & Backup Files
# ───────────────────────────────────────────────────────────────────
*.tmp
*.temp
*.bak
*.backup
*.old
*.orig

# ───────────────────────────────────────────────────────────────────
# Database
# ───────────────────────────────────────────────────────────────────
*.sqlite
*.sqlite3
*.db

# ───────────────────────────────────────────────────────────────────
# Archives
# ───────────────────────────────────────────────────────────────────
*.zip
*.tar.gz
*.rar
*.7z

# ───────────────────────────────────────────────────────────────────
# Keep These Files (Examples/Templates)
# ───────────────────────────────────────────────────────────────────
!.env.example
!terraform.tfvars.example
!docker-compose.yml
!docker-compose.override.yml.example
